---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageIntro from "../components/PageIntro.astro";
import Icon from "../components/Icon.astro";
import BuildLoop from "../components/BuildLoop.astro";
import { WORK, CURRENTLY_BUILDING } from "../data/work";
---

<BaseLayout
  title="Meet Ben Ackles | Technical Product Marketer & Builder"
  standaloneTitle
  description="I am a technical product marketer and builder specializing in positioning, punchy messaging, developer marketing, and go-to-market strategy."
>
  <Container class="flex flex-col gap-12 pt-5 pb-16 md:gap-20 md:pt-20 md:pb-24">
    <PageIntro
      title="I help technical products find their market."
      lede="I'm Ben Ackles, a product marketer and builder in Boulder, Colorado. I work across positioning, messaging, and go-to-market strategy, with a particular focus on products built for developers and technical teams."
    />

    <div class="flex flex-col gap-10 lg:flex-row lg:gap-16">
      <div class="flex flex-1 flex-col gap-8 md:gap-10">
        <BuildLoop />

        <div class="flex flex-col gap-6 text-base leading-[1.75] text-muted">
          <p>
            I've spent my career helping companies turn complicated products
            into clear reasons to care.
          </p>
          <p>
            That work usually starts well before launch. I partner with product
            managers, engineers, designers, sales teams, and customers to
            understand where a product fits, who it matters to, and what needs
            to be true for people to adopt it.
          </p>
          <p>
            My sweet spot is technical products. At <a
              href="https://dub.sh/9As5CWh"
              class="prose-link">BigCommerce</a
            >, I worked on developer-facing products including <a
              href="https://dub.sh/1mficYM"
              class="prose-link">GraphQL APIs</a
            >, <a href="https://dub.sh/kMe75M3" class="prose-link"
              >App Extensions</a
            >, and <a href="https://dub.sh/LGdyGTp" class="prose-link"
              >Catalyst</a
            >, an open-source storefront framework. At <a
              href="https://dub.sh/7BDPiVS"
              class="prose-link">Storyblok</a
            >, I led a company-wide positioning initiative to sharpen how the
            headless CMS differentiated in a crowded market, then translated
            that positioning into messaging for developer, marketer, and
            enterprise audiences. More recently, I’ve worked on bringing AI
            capabilities to market inside an established SaaS platform.
          </p>
        </div>
      </div>

      <div class="flex flex-col gap-8 lg:w-[420px] lg:shrink-0">
        <section
          class="flex flex-col gap-5 rounded-2xl border border-border bg-card p-6"
        >
          <h2 class="flex items-center gap-2 text-sm font-semibold text-ink">
            <Icon name="briefcase-business" class="text-muted" />
            Work
          </h2>
          <ul class="flex flex-col gap-4">
            {
              WORK.map((job) => (
                <li class="flex items-center gap-3">
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-[20px] border border-border bg-card text-ink">
                    <Icon name={job.icon} />
                  </span>
                  <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                    <span class="truncate text-sm font-semibold text-ink">
                      {job.company}
                    </span>
                    <span class="text-[13px] text-muted md:truncate">
                      {job.role}
                    </span>
                  </span>
                  <span class="shrink-0 text-xs whitespace-nowrap text-subtle">
                    {job.period}
                  </span>
                </li>
              ))
            }
          </ul>
        </section>

        <section
          class="flex flex-col gap-3 rounded-2xl border border-border bg-card p-6"
        >
          <h2 class="text-xs font-bold tracking-wide text-accent uppercase">
            Currently Building
          </h2>
          <p class="text-[15px] font-semibold text-ink">{CURRENTLY_BUILDING}</p>
        </section>
      </div>
    </div>
  </Container>
</BaseLayout>
