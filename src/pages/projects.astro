---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import PageIntro from "../components/PageIntro.astro";
import Icon from "../components/Icon.astro";
import { PROJECTS, type DotColor } from "../data/projects";

const dotClass: Record<DotColor, string> = {
  bigcommerce: "bg-dot-bigcommerce",
  storyblok: "bg-dot-storyblok",
  enumerate: "bg-dot-enumerate",
  signal: "bg-dot-signal",
};

const featured = PROJECTS.find((project) => project.featured);
const rest = PROJECTS.filter((project) => !project.featured);

const badgeClass =
  "ml-2 inline-block translate-y-[-1px] rounded bg-badge px-2 py-[3px] align-middle text-[10px] font-medium tracking-[0.8px] whitespace-nowrap text-eyebrow";
---

<BaseLayout
  title="Positioning, Messaging & GTM Projects | Ben Ackles"
  standaloneTitle
  description="Explore how I turn technical products into clear positioning, punchy messaging, developer marketing, and go-to-market strategy."
>
  <Container class="flex flex-col gap-12 pt-5 pb-16 md:gap-16 md:pt-20 md:pb-24">
    <PageIntro
      title="How I help technical products find their market."
      lede="Selected work across developer platforms, AI, headless CMS, and zero-to-one products. Positioning, messaging, go-to-market strategy, developer education, and launch execution."
    />

    <div class="flex flex-col gap-6">
    {
      featured && (
        <article class="flex flex-col gap-4 rounded-2xl border border-accent bg-card p-6 drop-shadow-[0_2px_6px_var(--c-card-shadow)] md:p-8">
          <p class="eyebrow">{featured.eyebrow}</p>
          <div class="flex items-center gap-3">
            <span
              class:list={["size-8 shrink-0 rounded-full", dotClass[featured.dot]]}
              aria-hidden="true"
            />
            <h2 class="text-[22px] leading-[1.2] font-bold tracking-[-0.5px] text-balance text-ink md:text-[28px]">
              {featured.name}
              {featured.status && (
                <span class={badgeClass}>{featured.status}</span>
              )}
            </h2>
          </div>
          <p class="max-w-[720px] text-[15px] leading-[1.6] text-muted md:text-base md:leading-[1.75]">
            {featured.summary}
          </p>
          <a
            href={featured.href}
            class="group inline-flex items-center gap-1 text-[13px] font-semibold text-accent"
          >
            {featured.linkLabel} ↗
            <Icon
              name="chevron-right"
              class="transition-transform group-hover:translate-x-0.5"
            />
          </a>
        </article>
      )
    }

    {/*
      Four across on desktop, two at md. Below md the single column is
      staggered: odd cards inset on the right, even cards on the left, so the
      stack reads as a zig-zag rather than a plain list.
    */}
    <ul class="grid gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-4">
      {
        rest.map((project) => (
          <li class="flex flex-col gap-4 rounded-2xl border border-border bg-card p-7 drop-shadow-[0_2px_6px_var(--c-card-shadow)] max-md:odd:mr-6 max-md:even:ml-6 lg:p-6">
            <p class="eyebrow">{project.eyebrow}</p>
            <div class="flex items-center gap-3">
              <span
                class:list={[
                  "size-8 shrink-0 rounded-full",
                  dotClass[project.dot],
                ]}
                aria-hidden="true"
              />
              {/*
                The badge sits inside the heading so it flows with the last
                word rather than wrapping onto its own line when the title
                fills the row.
              */}
              <h2 class="text-lg font-bold text-balance text-ink">
                {project.name}
                {project.status && (
                  <span class={badgeClass}>{project.status}</span>
                )}
              </h2>
            </div>
            <p class="flex-1 text-sm leading-[1.6] text-muted">
              {project.summary}
            </p>
            <a
              href={project.href}
              class="group inline-flex items-center gap-1 text-[13px] font-semibold text-accent"
            >
              {project.linkLabel} ↗
              <Icon
                name="chevron-right"
                class="transition-transform group-hover:translate-x-0.5"
              />
            </a>
          </li>
        ))
      }
    </ul>
    </div>
  </Container>
</BaseLayout>
