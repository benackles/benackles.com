---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import NavPill from "./NavPill.astro";
import { NAV, SHOW_BOOKING_CTA, SITE } from "../consts";
import avatar from "../assets/avatar.jpg";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);

/*
  Two items fit alongside the booking CTA down to a 360px screen, so they
  stay visible rather than collapsing into a hamburger — the nav is the
  cheaper thing to keep one tap away. Beyond two they collapse behind a
  hamburger in the right corner; adding a third entry to NAV flips this on
  its own. The CTA is the binding constraint here: without it there is room
  for three, but the count is kept at two so toggling SHOW_BOOKING_CTA
  never overflows the header.
*/
const INLINE_NAV_MAX = 2;
const navFitsInline = NAV.length <= INLINE_NAV_MAX;
const navPillClass = navFitsInline ? undefined : "hidden md:block";
---

<header class="bg-bg">
  <div
    class="mx-auto flex w-full max-w-[1440px] items-center justify-between gap-3 px-5 py-4 md:px-24 md:py-6"
  >
    <a href="/" aria-label={`${SITE.author} — home`}>
      <span
        class="flex size-[56px] items-center justify-center rounded-[28px] border border-border bg-card"
      >
        <Image
          src={avatar}
          alt=""
          width={40}
          height={40}
          densities={[1, 2]}
          loading="eager"
          class="size-10 rounded-[20px] object-cover"
        />
      </span>
    </a>

    <div class="flex items-center gap-3">
      <NavPill class={navPillClass} />

      {
        SHOW_BOOKING_CTA && (
          <a
            href={SITE.bookingUrl}
            class="shrink-0 rounded-[20px] border border-border bg-brand px-3 py-2.5 text-[13px] leading-5 font-medium whitespace-nowrap text-white transition-opacity hover:opacity-90 md:px-5"
          >
            Book a time
          </a>
        )
      }

      {
        !navFitsInline && (
          <details class="group relative md:hidden" name="site-nav">
            <summary
              aria-label="Menu"
              class="flex size-9 cursor-pointer list-none items-center justify-center rounded-[18px] border border-border bg-surface text-muted [&::-webkit-details-marker]:hidden"
            >
              <Icon name="menu" class="group-open:hidden" />
              <Icon name="x" class="hidden group-open:block" />
            </summary>
            <nav
              aria-label="Primary"
              class="absolute right-0 z-20 mt-2 w-44 rounded-2xl border border-border bg-card p-2 drop-shadow-[0_2px_6px_var(--c-pill-shadow)]"
            >
              <ul class="flex flex-col text-sm font-medium">
                {NAV.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? "page" : undefined}
                      class:list={[
                        "block rounded-lg px-3 py-2",
                        isActive(item.href) ? "text-accent" : "text-muted",
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )
      }
    </div>
  </div>
</header>
