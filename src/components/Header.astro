---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { NAV, SITE } from "../consts";
import avatar from "../assets/avatar.jpg";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);

/*
  Up to two items fit comfortably in the pill on a 390px screen, so they
  stay visible. Beyond that they collapse behind a hamburger in the right
  corner. Adding a third entry to NAV flips this on its own.
*/
const INLINE_NAV_MAX = 2;
const navFitsInline = NAV.length <= INLINE_NAV_MAX;
---

<header class="bg-bg">
  <!--
    Three-column grid rather than justify-between so the nav stays centred
    whether or not the CTA column is rendered.
  -->
  <div
    class="mx-auto grid w-full max-w-[1440px] grid-cols-[1fr_auto_1fr] items-center px-5 py-4 md:px-24 md:py-6"
  >
    <a href="/" class="justify-self-start" aria-label={`${SITE.author} — home`}>
      <span
        class="flex size-9 items-center justify-center rounded-[18px] border border-border bg-card"
      >
        <Image
          src={avatar}
          alt=""
          width={28}
          height={28}
          densities={[1, 2]}
          loading="eager"
          class="size-7 rounded-[14px] object-cover"
        />
      </span>
    </a>

    <div class="justify-self-center">
      <nav
        aria-label="Primary"
        class:list={[
          "rounded-[99px] border border-border bg-surface px-4 py-2.5 drop-shadow-[0_1px_1.5px_var(--c-pill-shadow)]",
          navFitsInline ? "block" : "hidden md:block",
        ]}
      >
        <ul class="flex items-center gap-5 text-sm font-medium md:gap-6">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "whitespace-nowrap transition-colors hover:text-accent",
                    isActive(item.href) ? "text-accent" : "text-muted",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="flex items-center gap-3 justify-self-end">
      {/*
        Primary CTA — disabled until scheduling is set up. Restore by
        uncommenting; SITE.bookingUrl in src/consts.ts is the link target.

        <a
          href={SITE.bookingUrl}
          class="shrink-0 rounded-[20px] border border-border bg-brand px-4 py-1.5 text-[13px] font-medium whitespace-nowrap text-white transition-opacity hover:opacity-90 md:px-5 md:py-2"
        >
          Book a time
        </a>
      */}

      {
        !navFitsInline && (
          <details class="group relative md:hidden" name="site-nav">
            <summary
              aria-label="Menu"
              class="flex size-9 cursor-pointer list-none items-center justify-center rounded-[18px] border border-border bg-surface text-muted [&::-webkit-details-marker]:hidden"
            >
              <Icon name="menu" class="group-open:hidden" />
              <Icon name="x" class="hidden group-open:block" />
            </summary>
            <nav
              aria-label="Primary"
              class="absolute right-0 z-20 mt-2 w-44 rounded-2xl border border-border bg-card p-2 drop-shadow-[0_2px_6px_var(--c-pill-shadow)]"
            >
              <ul class="flex flex-col text-sm font-medium">
                {NAV.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? "page" : undefined}
                      class:list={[
                        "block rounded-lg px-3 py-2",
                        isActive(item.href) ? "text-accent" : "text-muted",
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )
      }
    </div>
  </div>
</header>
