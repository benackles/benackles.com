---
import { ANNOUNCEMENT } from "../consts";

/*
  Slim announcement bar above the header, for launches and other news.
  Toggle and copy live in ANNOUNCEMENT in src/consts.ts.

  Desktop: one centred row. Mobile: four fixed lines — tag, headline,
  tagline, then the link — each held to one line with whitespace-nowrap so
  the copy never wraps mid-phrase at 360-390px.

  Every part is a direct child of the same flex container, which is the
  whole layout: it stacks as a column on mobile, giving each part its own
  line, and becomes a single row at md+. No wrappers and no md:contents,
  because nothing needs to stay grouped with anything else.
*/
const { show, tag, headline, tagline, cta, href } = ANNOUNCEMENT;
---

{
  show && (
    <aside
      aria-label="Announcement"
      class="border-b border-border bg-badge text-[13px] leading-5 text-ink"
    >
      <div class="mx-auto flex min-h-11 w-full max-w-[1440px] flex-col items-center justify-center gap-1 px-5 py-2.5 text-center md:flex-row md:gap-3 md:px-24">
        <span class="rounded bg-brand px-1.5 py-0.5 text-[10px] leading-[14px] font-semibold tracking-[0.8px] text-white uppercase">
          {tag}
        </span>
        <span class="font-semibold whitespace-nowrap">{headline}</span>
        <span class="whitespace-nowrap">{tagline}</span>
        <a
          href={href}
          class="group font-semibold whitespace-nowrap text-accent transition-colors hover:text-ink"
        >
          {cta}{" "}
          {/*
            The arrow is its own element so it can slide on hover without
            dragging the label with it. aria-hidden because the link text
            already names the destination.
          */}
          <span
            aria-hidden="true"
            class="nudge-x inline-block group-hover:translate-x-0.5"
          >
            &rarr;
          </span>
        </a>
      </div>
    </aside>
  )
}
