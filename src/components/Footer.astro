---
import Icon from "./Icon.astro";
import { NAV, SITE, SOCIALS } from "../consts";

const year = new Date().getFullYear();
---

<footer class="bg-bg">
  <div class="mx-auto w-full max-w-[1440px] border-t border-border">
    <div
      class="flex flex-col gap-6 px-5 py-10 text-sm sm:flex-row sm:items-center sm:justify-between md:px-24 md:py-12"
    >
      {/*
        The links and the social icon stay on one 20px-spaced row at every
        width — the mobile design keeps them inline rather than stacking.
      */}
      <div class="flex items-center gap-5">
        <ul class="flex flex-wrap gap-5 text-muted">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-accent">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="flex items-center gap-4">
          {
            SOCIALS.map((social) => (
              <li>
                {/*
                  The chip is the 20px box the design specifies, but a 20px
                  hit area is under the 24px minimum for a pointer target, so
                  the padding on the anchor takes it to 36px and the negative
                  margin keeps the chip sitting on the design's 20px rhythm.
                */}
                <a
                  href={social.href}
                  aria-label={social.label}
                  rel="me noopener"
                  class="-m-2 flex p-2 text-muted transition-colors hover:text-accent"
                >
                  <span
                    class="flex size-5 items-center justify-center rounded-[18px] border border-border bg-surface"
                  >
                    <Icon name={social.icon} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="text-subtle">
        &copy; {year} {SITE.author}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
