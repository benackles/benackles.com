---
import Icon from "./Icon.astro";
import { NAV, SITE, SOCIALS } from "../consts";

const year = new Date().getFullYear();
---

<footer class="bg-bg">
  <div class="mx-auto w-full max-w-[1440px] border-t border-border">
    <div
      class="flex flex-col gap-4 px-5 py-10 text-sm sm:flex-row sm:items-center sm:justify-between md:px-24 md:py-12"
    >
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
        <ul class="flex flex-wrap gap-5 text-muted">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-accent">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="flex items-center gap-4">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.href}
                  aria-label={social.label}
                  rel="me noopener"
                  class="flex size-9 items-center justify-center rounded-[18px] border border-border bg-surface text-muted transition-colors hover:text-accent"
                >
                  <Icon name={social.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="text-subtle">
        &copy; {year} {SITE.author}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
