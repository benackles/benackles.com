---
/*
  Icons come from Lucide (@lucide/astro). The three brand marks are the
  exception: Lucide dropped its brand icons in v1, so github / linkedin /
  twitter are local SVGs in src/icons — the same glyphs the Figma file
  uses, with stroke-width normalised to Lucide's weight at 16px.

  Sizes below are the sizes the design specifies for each icon.
*/
import {
  BriefcaseBusiness,
  ChartScatter,
  ChevronRight,
  Mail,
  Menu,
  Sparkles,
  TestTube,
  X,
} from "@lucide/astro";

import GithubIcon from "../icons/github.svg";
import LinkedinIcon from "../icons/linkedin.svg";
import TwitterIcon from "../icons/twitter.svg";

const REGISTRY = {
  "briefcase-business": { component: BriefcaseBusiness, size: 18 },
  mail: { component: Mail, size: 16 },

  // Work-history glyphs (20px, matching the Figma company logos).
  sparkles: { component: Sparkles, size: 20 },
  "chart-scatter": { component: ChartScatter, size: 20 },
  "test-tube": { component: TestTube, size: 20 },
  "chevron-right": { component: ChevronRight, size: 12 },
  menu: { component: Menu, size: 20 },
  x: { component: X, size: 20 },
  twitter: { component: TwitterIcon, size: 16 },
  linkedin: { component: LinkedinIcon, size: 16 },
  github: { component: GithubIcon, size: 16 },
} as const;

export type IconName = keyof typeof REGISTRY;

interface Props {
  name: IconName;
  /** Overrides the design size for this icon. */
  size?: number;
  class?: string;
}

const { name, size, class: className } = Astro.props;
const { component: Glyph, size: defaultSize } = REGISTRY[name];
const px = size ?? defaultSize;
---

<Glyph width={px} height={px} class={className} aria-hidden="true" />
