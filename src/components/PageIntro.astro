---
interface Props {
  title: string;
  lede: string;
}

const { title, lede } = Astro.props;
---

{/*
  Mobile centres the hero under the profile block in the header; desktop
  returns it to the left-aligned 820px measure.
*/}
<div class="flex max-w-[820px] flex-col gap-3.5 text-center md:gap-6 md:text-left">
  {/*
    The heading and lede fade up as a pair, the lede a beat behind, so the
    hero resolves in reading order rather than arriving all at once. The
    text is in the markup and the animation is CSS-only, so crawlers and
    reduced-motion visitors get the finished state with nothing running.
    See the motion block in src/styles/global.css.
  */}
  <h1
    class="animate-rise-in text-[32px] leading-[1.2] font-extrabold tracking-[-1px] text-ink md:text-[56px] md:leading-[1.15] md:tracking-normal"
  >
    {title}
  </h1>
  <p
    class="animate-rise-in text-base leading-[1.6] text-muted [animation-delay:90ms] md:text-[18px]"
  >
    {lede}
  </p>
</div>
