---
interface Props {
  title: string;
  lede: string;
}

const { title, lede } = Astro.props;
---

<div class="flex max-w-[820px] flex-col gap-6">
  <h1
    class="text-[36px] leading-[1.15] font-extrabold tracking-[-0.01em] text-ink md:text-[56px]"
  >
    {title}
  </h1>
  <p class="text-base leading-[1.6] text-muted md:text-[18px]">{lede}</p>
</div>
