---
interface Props {
  title: string;
  lede: string;
}

const { title, lede } = Astro.props;
---

{/*
  Mobile centres the hero under the profile block in the header; desktop
  returns it to the left-aligned 820px measure.
*/}
<div class="flex max-w-[820px] flex-col gap-3.5 text-center md:gap-6 md:text-left">
  <h1
    class="text-[32px] leading-[1.2] font-extrabold tracking-[-1px] text-ink md:text-[56px] md:leading-[1.15] md:tracking-normal"
  >
    {title}
  </h1>
  <p class="text-base leading-[1.6] text-muted md:text-[18px]">{lede}</p>
</div>
